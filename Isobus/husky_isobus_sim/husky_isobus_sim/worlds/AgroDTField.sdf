<?xml version="1.0"?>
<sdf version="1.9">
  <world name="AgroDTField">
    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 18 0 0 0</pose>
      <diffuse>0.92 0.90 0.82 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.45 0.22 -1</direction>
    </light>

    <model name="soil_ground">
      <static>true</static>
      <pose>0 0 -0.10 0 0 0</pose>
      <link name="ground">
        <collision name="collision">
          <geometry><box><size>40 28 0.20</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>40 28 0.20</size></box></geometry>
          <material>
            <ambient>0.23 0.12 0.055 1</ambient>
            <diffuse>0.30 0.16 0.07 1</diffuse>
            <specular>0.03 0.03 0.03 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Muretas escuras para dar o aspecto de canteiro/campo cercado da referência. -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 13.5 1.40 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>40 1 2.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>40 1 2.8</size></box></geometry>
          <material><ambient>0.09 0.045 0.025 1</ambient><diffuse>0.13 0.06 0.03 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -13.5 1.40 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>40 1 2.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>40 1 2.8</size></box></geometry>
          <material><ambient>0.09 0.045 0.025 1</ambient><diffuse>0.13 0.06 0.03 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>19.5 0 1.40 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>1 28 2.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1 28 2.8</size></box></geometry>
          <material><ambient>0.09 0.045 0.025 1</ambient><diffuse>0.13 0.06 0.03 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-19.5 0 1.40 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>1 28 2.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1 28 2.8</size></box></geometry>
          <material><ambient>0.09 0.045 0.025 1</ambient><diffuse>0.13 0.06 0.03 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Plantação em 3 blocos; cada bloco possui 2 fileiras próximas.
         Há um corredor maior entre os blocos. Total: 6 fileiras x 12 plantas = 72 plantas. -->
    <include><uri>model://corn_plant</uri><name>corn_row1_1</name><pose>-6.00 -5.00 0 0 0 0</pose></include>
    <include><uri>model://corn_plant</uri><name>corn_row1_2</name><pose>-4.90 -5.00 0 0 0 0</pose></include>
